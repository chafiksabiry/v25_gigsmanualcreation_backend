{
  "name": "gig-management-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --exec npx ts-node src/server.ts",
    "build": "node node_modules/typescript/lib/tsc.js",
    "backfill:setup-steps": "ts-node src/scripts/backfillSetupSteps.ts",
    "backfill:setup-steps:dry": "ts-node src/scripts/backfillSetupSteps.ts --dry-run",
