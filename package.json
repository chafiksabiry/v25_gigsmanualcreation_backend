{
  "name": "gig-management-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --exec npx ts-node src/server.ts",
    "build": "tsc",
    "test": "jest",
    "export": "npm run build && node scripts/prepare-export.js",
    "import-countries": "npx ts-node src/scripts/importCountries.ts",
    "import-countries-js": "node src/scripts/importCountries.js",
    "clean-countries": "npx ts-node src/scripts/cleanCountries.ts",
    "test-countries": "npx ts-node src/scripts/testCountriesAPI.ts",
    "test-ai": "npx ts-node src/scripts/testAIGeneration.ts",
    "test-morocco": "npx ts-node src/scripts/testMoroccoDetection.ts",
    "test-external-api": "npx ts-node src/scripts/testExternalCountriesAPI.ts",
    "test-connection": "npx ts-node src/scripts/testCountriesConnection.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^3.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-fileupload": "^1.5.1",
    "express-validator": "^7.0.1",
    "i18n-iso-countries": "^7.14.0",
    "mongoose": "^8.1.1",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "openai": "^4.104.0",
    "streamifier": "^0.1.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-fileupload": "^1.5.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.11.16",
    "@types/streamifier": "^0.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
