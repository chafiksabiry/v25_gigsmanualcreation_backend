  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@types/bcryptjs": "^3.0.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-fileupload": "^1.5.1",
    "express-validator": "^7.0.1",
    "i18n-iso-countries": "^7.14.0",
    "mongoose": "^8.1.1",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "openai": "^4.104.0",
    "streamifier": "^0.1.1",
    "typescript": "^5.3.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-fileupload": "^1.5.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.11.16",
    "@types/streamifier": "^0.1.2",
    "ts-node-dev": "^2.0.0"
  }
